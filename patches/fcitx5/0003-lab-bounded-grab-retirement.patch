+// Private lab only: records retain the complete listener target, never just proxy.
+WaylandIMInputContextV2::RetiredGrab::~RetiredGrab() {
+    if (barrier) { wl_callback_destroy(barrier); }
+}
+
+void WaylandIMInputContextV2::drainDone(void *data, wl_callback *callback,
+                                      uint32_t) {
+    auto *record = static_cast<RetiredGrab *>(data);
+    if (record->barrier != callback) { std::_Exit(125); }
+    wl_callback_destroy(callback);
+    record->barrier = nullptr;
+    record->drained = true;
+    record->owner->collectDrainedGrabs();
+}
+
+void WaylandIMInputContextV2::collectDrainedGrabs() {
+    for (auto it = retiredGrabs_.begin(); it != retiredGrabs_.end();) {
+        if ((*it)->drained && !(*it)->grab->inCallback()) {
+            it = retiredGrabs_.erase(it);
+        } else { ++it; }
+    }
+}
+
+void WaylandIMInputContextV2::retireKeyboardGrab() {
+    // Reject reentrant handoff before it can resume old input against new focus.
+    if (inputWorkDepth_) { std::_Exit(125); }
+    collectDrainedGrabs();
+    if (!keyboardGrab_) { return; }
+    timeEvent_->setEnabled(false);
+    repeatKey_ = 0;
+    repeatSym_ = FcitxKey_None;
+    if (retiredGrabs_.size() >= 8) { std::_Exit(125); }
+    auto record = std::make_unique<RetiredGrab>();
+    record->owner = this;
+    if (!keyboardGrab_->releaseForDrain()) { std::_Exit(125); }
+    record->grab = std::move(keyboardGrab_);
+    // Pinned upstream dispatches both grab and display.sync on default queue.
+    record->barrier = wl_display_sync(*server_->display());
+    if (!record->barrier) { std::_Exit(125); }
+    static const wl_callback_listener listener = {drainDone};
+    if (wl_callback_add_listener(record->barrier, &listener, record.get()) < 0) {
+        std::_Exit(125);
+    }
+    retiredGrabs_.push_back(std::move(record));
+}
+
+void WaylandIMInputContextV2::retiredKey(uint32_t, uint32_t, uint32_t) {
+    // Lifetime observation only. The old event has no proven target/focus
+    // ownership or press/release pairing. Never replay it into a new field.
+    // A deliberate FAIL is preferable to a false transport success.
+    std::_Exit(125);
+}
