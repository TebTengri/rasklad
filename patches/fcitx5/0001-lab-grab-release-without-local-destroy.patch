+ZwpInputMethodKeyboardGrabV2::~ZwpInputMethodKeyboardGrabV2() {
+    if (releasedForDrain_) {
+        // The server release was already sent. Destroy only the local proxy;
+        // the normal deleter would send a second destructor request.
+        auto *proxy = data_.release();
+        wl_proxy_destroy(reinterpret_cast<wl_proxy *>(proxy));
+    }
+}
+
+bool ZwpInputMethodKeyboardGrabV2::releaseForDrain() {
+    if (releasedForDrain_ || !data_ || version_ < 1) {
+        return false;
+    }
+    releasedForDrain_ = true;
+    auto *proxy = reinterpret_cast<wl_proxy *>(data_.get());
+    wl_proxy_marshal_flags(proxy, ZWP_INPUT_METHOD_KEYBOARD_GRAB_V2_RELEASE,
+                           nullptr, version_, 0);
+    return true;
+}
