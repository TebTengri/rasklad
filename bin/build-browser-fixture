#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""Build an owned-field fixture, generating the US/RU map from the C++ source.
No dependencies, models, network, installation or browser profile access.
"""
from pathlib import Path
import ast
import json
import re
import shutil
import subprocess
import hashlib

root = Path(__file__).resolve().parent.parent
source = (root / 'src/layoutconverter.cpp').read_text()
pairs = [(ast.literal_eval(a), ast.literal_eval(b)) for a, b in
         re.findall(r"\{u('(?:\\.|[^'\\])*'), u('(?:\\.|[^'\\])*')\}", source)]
if len(pairs) != 94 or any(len(a) != 1 or len(b) != 1 for a, b in pairs):
    raise SystemExit('Unexpected converter table; review generator before rebuilding')
if len({a for a, _ in pairs}) != 94 or len({b for _, b in pairs}) != 94:
    raise SystemExit('Ambiguous converter table')
out = root / 'build/browser-fixture'
# Refuse build-directory symlinks instead of following them outside the worktree.
for directory in [root / 'build', root / 'build/browser-policy-export', out]:
    if directory.is_symlink():
        raise SystemExit('Refusing symlink build directory')
    directory.mkdir(parents=True, exist_ok=True)
for name in ['adapter.js', 'router.js', 'scorer.js', 'evidence.js', 'fixture.html', 'fixture.js', 'converter.js', 'policy.js', 'provenance.json', 'synthetic-conformance.json', 'synthetic-model.js']:
    if (out / name).is_symlink():
        raise SystemExit('Refusing symlink output file')
builder = root / 'build/browser-policy-export'
for name in ['Makefile', 'browser_policy_export']:
    if (builder / name).is_symlink():
        raise SystemExit('Refusing symlink build output')
subprocess.run(['qmake6', '-o', 'Makefile', str(root / 'tools/browser_policy/export.pro')],
               cwd=builder, check=True, stdout=subprocess.DEVNULL, timeout=30)
subprocess.run(['make', '-j2'], cwd=builder, check=True, stdout=subprocess.DEVNULL, timeout=120)
policy = json.loads(subprocess.check_output([str(builder / 'browser_policy_export')], timeout=30))
synthetic_json = subprocess.check_output([str(builder / 'browser_policy_export'), '--synthetic'], timeout=30)
synthetic = json.loads(synthetic_json)
if synthetic.get('schema') != 1 or len(synthetic.get('models', [])) != 7:
    raise SystemExit('Unexpected synthetic conformance schema')
(out / 'synthetic-conformance.json').write_bytes(synthetic_json)
fixture_bytes = synthetic['models'][synthetic['fixtureModelIndex']]['bytesBase64']
(out / 'synthetic-model.js').write_text('''// SYNTHETIC TEST WEIGHTS ONLY. Generated original numeric fixture; not a linguistic model.
globalThis.RaskladSyntheticModelBytes=Uint8Array.from(atob(BASE64),c=>c.charCodeAt(0));
'''.replace('BASE64', json.dumps(fixture_bytes)))
if policy.get('schema') != 1 or len(policy.get('table', [])) != 512:
    raise SystemExit('Unexpected native policy schema')
provenance = {name: hashlib.sha256((root / name).read_bytes()).hexdigest() for name in [
    'src/decisionrouter.h', 'src/decisionrouter.cpp', 'src/ngramdetector.h',
    'src/ngramdetector.cpp', 'src/layoutconverter.h', 'src/layoutconverter.cpp',
    'tools/browser_policy/export.cpp', 'tools/browser_policy/export.pro',
    'tools/browser_policy/synthetic.cpp', 'tools/browser_policy/synthetic.h',
    'browser/adapter.js', 'browser/router.js', 'browser/scorer.js', 'browser/evidence.js', 'bin/build-browser-fixture']}
(root / 'build/browser-fixture/provenance.json').write_text(json.dumps(provenance, indent=2)+'\n')
policy_script = '''// Generated by evaluating the native DecisionRouter. MIT. Do not edit.
(function(root){'use strict';
function freeze(value){if(value && typeof value === 'object'){for(const child of Object.values(value))freeze(child);Object.freeze(value);}return value;}
const data=freeze(DATA);
root.RaskladPolicyData=data;
if(typeof module!=='undefined')module.exports=data;
})(globalThis);
'''.replace('DATA', json.dumps(policy, ensure_ascii=False, separators=(',', ':')))
(out / 'policy.js').write_text(policy_script)
for name in ['adapter.js', 'router.js', 'scorer.js', 'evidence.js', 'fixture.html', 'fixture.js']:
    shutil.copyfile(root / 'browser' / name, out / name)
script = '''// Generated from the project-owned C++ key map. MIT. Do not edit.
(function(root) {
'use strict';
const pairs = PAIRS;
const us = new Map(pairs), ru = new Map(pairs.map(([a,b])=>[b,a]));
function convert(text, direction) {
  const map = direction === 'us-ru' ? us : direction === 'ru-us' ? ru : null;
  if (!map) return text;
  let result = '';
  for (let i=0; i<text.length; i++) {
    const next = i+1<text.length ? String.fromCodePoint(text.codePointAt(i+1)) : '';
    result += /\\p{M}/u.test(next) ? text[i] : (map.get(text[i]) ?? text[i]);
  }
  return result;
}
root.RaskladConverter = Object.freeze({convert});
if(typeof module !== 'undefined') module.exports = root.RaskladConverter;
})(globalThis);
'''.replace('PAIRS', json.dumps(pairs, ensure_ascii=False))
(out / 'converter.js').write_text(script)
print(json.dumps({'fixture': 'build/browser-fixture/fixture.html', 'keyPairs': len(pairs),
                  'policyStates': len(policy['table']), 'realModelIncluded': False, 'syntheticModelBytes': policy['modelSpec']['serializedBytes']}))
