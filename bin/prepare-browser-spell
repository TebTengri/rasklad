#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""Prepare synthetic native spell fixtures without downloading code.
Never runs npm/install scripts, opens real dictionaries or installs anything.
"""
from pathlib import Path
import argparse,json,subprocess
root=Path(__file__).resolve().parent.parent
parser=argparse.ArgumentParser(description=__doc__)
args=parser.parse_args()
lock=json.loads((root/'tools/browser_spell/source-lock.json').read_text())
if lock['release_approved'] is not False:raise SystemExit('This tool accepts a developer candidate only')
for name in ['build','build/browser-spell-native']:
 p=root/name
 if p.is_symlink():raise SystemExit('Refusing symlink directory')
 p.mkdir(parents=True,exist_ok=True)
build=root/'build/browser-spell-native'
for name in ['Makefile','native_spell_fixture','native.json','build.txt']:
 if (build/name).is_symlink():raise SystemExit('Refusing symlink output')
subprocess.run([str(root/'bin/build-browser-fixture')],check=True,stdout=subprocess.DEVNULL,timeout=180)
with (build/'build.txt').open('w') as log:
 subprocess.run(['qmake6','-o','Makefile',str(root/'tools/browser_spell/native.pro')],cwd=build,check=True,stdout=log,timeout=30)
 subprocess.run(['make','-j2'],cwd=build,check=True,stdout=log,timeout=120)
raw=subprocess.check_output([str(build/'native_spell_fixture')],timeout=30)
gold=json.loads(raw)
if gold.get('schema')!=1 or gold.get('nativeVersion')!=lock['native_reference_version']:raise SystemExit('Native reference version/schema mismatch')
(build/'native.json').write_bytes(raw)
print(json.dumps({'candidate':'Hunspell@'+lock['version'],'releaseApproved':False,'nativeVersion':gold['nativeVersion'],'syntheticSpellCases':sum(len(p['cases']) for p in gold['profiles'].values()),'realDataOpened':False}))
