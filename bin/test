#!/usr/bin/env bash
# Собирает проект через bin/build и запускает модульные тесты Qt Test:
# сначала rasklad_tests (ядро преобразования), затем detector_tests
# (экспериментальный детектор SYS-232), затем benchmark_tests (helper'ы
# независимой оценки SYS-233), затем context_tests (политики контекста
# SYS-237, без Hunspell) и, если доступна Hunspell, domain_tests и
# morphology_tests. Аргументы передаются всем бинарникам
# (например, -v2); имя тестовой функции подходит только одному.
set -euo pipefail

script_dir="$(cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
root_dir="$(cd -P -- "${script_dir}/.." && pwd -P)"
build_dir="${root_dir}/build"

"${script_dir}/build"

test_dir="${build_dir}/tests"
test_bin="${test_dir}/rasklad_tests"
detector_dir="${build_dir}/tests/detector"
detector_bin="${detector_dir}/detector_tests"
benchmark_dir="${build_dir}/tests/benchmark"
benchmark_bin="${benchmark_dir}/benchmark_tests"
# SYS-237: политики контекста опыта 005; без Hunspell, собираются всегда.
context_dir="${build_dir}/tests/context"
context_bin="${context_dir}/context_tests"

for bin in "${test_bin}" "${detector_bin}" "${benchmark_bin}" "${context_bin}"; do
    if [[ ! -x "${bin}" ]]; then
        echo "bin/test: тестовый бинарник не найден: ${bin}" >&2
        exit 1
    fi
done

# Тесты не требуют GUI, внешних словарей и корпуса; запускаются из каталога сборки.
(cd -- "${test_dir}" && "${test_bin}" "$@")
(cd -- "${detector_dir}" && "${detector_bin}" "$@")
(cd -- "${benchmark_dir}" && "${benchmark_bin}" "$@")
(cd -- "${context_dir}" && "${context_bin}" "$@")

if pkg-config --exists hunspell; then
    morphology_dir="${build_dir}/tests/morphology"
    morphology_bin="${morphology_dir}/morphology_tests"
    if [[ ! -x "${morphology_bin}" ]]; then
        echo "bin/test: morphology_tests не собран при доступной Hunspell" >&2
        exit 1
    fi
    # SYS-236: синтетические тесты helper'ов опыта 004 (без корпуса и Hunspell-вызовов).
    domain_dir="${build_dir}/tests/domain"
    domain_bin="${domain_dir}/domain_tests"
    if [[ ! -x "${domain_bin}" ]]; then
        echo "bin/test: domain_tests не собран при доступной Hunspell" >&2
        exit 1
    fi
    (cd -- "${domain_dir}" && "${domain_bin}" "$@")
    cd -- "${morphology_dir}"
    exec "${morphology_bin}" "$@"
else
    echo "bin/test: morphology_tests и domain_tests пропущены — pkg-config hunspell недоступен" >&2
fi
