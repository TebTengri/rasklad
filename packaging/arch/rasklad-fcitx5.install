# SYS-270: pacman runs this as root and cannot undo a user's rasklad-setup
# --install; it only says what is left and how to undo it. Nothing is changed.

pre_remove() {
  cat <<'EOF'
==> rasklad-fcitx5: if you ran rasklad-setup --install, undo it first, as yourself:
      rasklad-setup --revert
    If the package is already gone: double Alt and the keep-only-us block in
    ~/.config/hypr/input.lua switch themselves off, and Hyprland is back on its own
    layouts after "hyprctl reload". The Omarchy bar may show an empty slot where
    the Rasklad widget was: put "omarchy.keyboard-layout" back in
    ~/.config/omarchy/shell.json (a copy is in shell.json.rasklad.bak).
EOF
}
