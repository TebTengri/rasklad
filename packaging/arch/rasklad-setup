#!/usr/bin/python3 -I
# SPDX-License-Identifier: MIT
# rasklad-setup (SYS-252): connect an installed rasklad-fcitx5 to this user's
# Omarchy desktop, check it, and undo it. The package never runs this: only the
# user changes their own settings.
#
#   rasklad-setup --check     what works and what is missing (states only)
#   rasklad-setup --install   show the changes, ask, apply; running it again
#                             changes nothing
#   rasklad-setup --revert    put back exactly what --install replaced
#
# Steps: the double left Alt rule in ~/.config/hypr/bindings.lua; one Hyprland
# layout with no group toggle in ~/.config/hypr/input.lua (Fcitx switches
# layouts); the bar widget link in ~/.config/omarchy/plugins and its id in
# ~/.config/omarchy/shell.json; keyboard-us and keyboard-ru in the current Fcitx
# group. Every file is copied before it is changed (a .rasklad.bak beside it and
# a private copy under ~/.local/state/rasklad-setup); --revert restores a file
# only if it is still exactly what --install wrote. A config file that is a
# symlink (a dotfiles repository) is never written. Nothing typed is read or
# printed.
import difflib
import errno
import fcntl
import hashlib
import json
import os
import re
import socket
import stat
import subprocess
import sys
import tempfile

SHARE = "/usr/share/rasklad-fcitx5"
RULE = SHARE + "/hyprland/double-alt.lua"
WIDGET = SHARE + "/omarchy/rasklad.layout"
HYPRCTL = "/usr/bin/hyprctl"
BEGIN = "-- BEGIN rasklad-setup"
END = "-- END rasklad-setup"
# SYS-268: in every input.lua block this version writes (us kept, by choice).
# SYS-272: an older or edited block. --revert takes it out (inside the Hyprland
# session); if it stays, the user removes it and runs --revert again, which then
# checks the live layouts and forgets it; --install after that adds the new one.
LEGACY_ADVICE = ("an older or edited layout block: run --revert inside the Hyprland session; "
                 "if the block stays, remove it from input.lua and run --revert again, then --install")
EDITED_ADVICE = ("the layout block was edited after install; left as is "
                 "(--revert keeps an edited input.lua too)")
LAYOUT_MARK = "-- rasklad-setup layout 3: us kept for the lock screen, chosen by the user"
# The rule loaded by an uncommented line, as INSTALL.md shows it (a manual setup).
RULE_LINE = re.compile(r'^\s*local\s+rasklad\s*=\s*"' + re.escape(RULE) + r'"', re.M)
STOCK_ID = re.compile(rb'("id"\s*:\s*)"omarchy\.keyboard-layout"')
XKB = re.compile(r"[A-Za-z0-9_:,.+-]*")
# SYS-268: us variants that type Latin letters (the lock screen keeps only us).
LATIN_US = {"", "intl", "altgr-intl", "alt-intl", "euro", "mac", "colemak", "dvorak", "workman"}
# SYS-268: the input.lua block, from BEGIN up to END, exactly as written.
# SYS-270: applied only while the package is installed; after pacman -R Hyprland
# is back on the lines above it (its own layouts and switch) at the next reload.
LAYOUT_BLOCK = (BEGIN + ": Fcitx switches layouts (keyboard-us, keyboard-ru), so Hyprland\n"
                "-- keeps one layout and no group toggle. Remove with rasklad-setup --revert.\n"
                + LAYOUT_MARK + "\n"
                "local rasklad_package = io.open(\"" + RULE + "\", \"r\")\n"
                "if rasklad_package then\n  rasklad_package:close()\n"
                "  hl.config({\n    input = {\n      kb_layout = \"us\",\n      kb_variant = \"{variant}\",\n"
                "      kb_options = \"{options}\",\n    },\n  })\nend\n")
LAYOUT_BLOCK_RE = re.compile(re.escape(LAYOUT_BLOCK).replace(re.escape("{variant}"), XKB.pattern)
                             .replace(re.escape("{options}"), r"(?![^\"]*grp:)" + XKB.pattern).encode())

HOME = os.path.expanduser("~")
CONFIG = os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config")
STATE_HOME = os.environ.get("XDG_STATE_HOME") or os.path.join(HOME, ".local", "state")
BINDINGS = os.path.join(CONFIG, "hypr", "bindings.lua")
INPUT = os.path.join(CONFIG, "hypr", "input.lua")
SHELL_JSON = os.path.join(CONFIG, "omarchy", "shell.json")
FILES = (BINDINGS, INPUT, SHELL_JSON)
PLUGIN_LINK = os.path.join(CONFIG, "omarchy", "plugins", "rasklad.layout")
STATE_DIR = os.path.join(STATE_HOME, "rasklad-setup")
BACKUP_DIR = os.path.join(STATE_DIR, "backup")
STATE_FILE = os.path.join(STATE_DIR, "state.json")


class Refused(Exception):
  pass


def say(state, step, note=""):
  print(("%-8s %-18s %s" % (state, step, note)) if note else ("%-8s %s" % (state, step)))


# --- files --------------------------------------------------------------------

def read(path):
  # SYS-272: opened without blocking and checked on the open file, so a path
  # swapped for a FIFO or a device in between can neither stall nor be read.
  try:
    fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK | os.O_CLOEXEC)
  except FileNotFoundError:
    return None
  try:
    if not stat.S_ISREG(os.fstat(fd).st_mode):
      raise OSError(errno.EINVAL, "not a regular file", path)
    with os.fdopen(fd, "rb") as f:
      fd = None
      return f.read()
  finally:
    if fd is not None:
      os.close(fd)


def sha(data):
  return hashlib.sha256(data).hexdigest()


def prepare_atomic(path, data, mode=None):
  """A fresh private temporary file beside the target (never a fixed name that
  could be a planted symlink), written and synced; returns its path. Made before
  the last comparison, so only the rename follows it (SYS-272)."""
  if mode is None:
    mode = stat.S_IMODE(os.lstat(path).st_mode) if os.path.lexists(path) else 0o644
  fd, tmp = tempfile.mkstemp(prefix=".rasklad-setup.", dir=os.path.dirname(path))
  try:
    with os.fdopen(fd, "wb") as f:
      f.write(data)
      f.flush()
      os.fchmod(f.fileno(), mode)
      os.fsync(f.fileno())
  except BaseException:
    discard(tmp)
    raise
  return tmp


def discard(tmp):
  try:
    os.unlink(tmp)
  except OSError:
    pass


def commit_atomic(tmp, path):
  try:
    os.replace(tmp, path)
  except BaseException:
    discard(tmp)
    raise


def write_atomic(path, data, mode=None):
  commit_atomic(prepare_atomic(path, data, mode), path)


def private_state_dir():
  # Our own directory, mode 0700, owned by us; never a symlink.
  for d in (STATE_DIR, BACKUP_DIR):
    os.makedirs(d, mode=0o700, exist_ok=True)
    info = os.lstat(d)
    if stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid():
      raise Refused("%s is not a private directory of this user" % d)
    os.chmod(d, 0o700)


def lock_state():
  """SYS-272: one rasklad-setup at a time (--install and --revert). The lock is
  held until the process exits. One fixed file next to our state directory for
  every invocation that shares this state; never removed, so no second inode
  can appear while a run holds the first."""
  os.makedirs(STATE_HOME, mode=0o700, exist_ok=True)
  fd = os.open(os.path.join(STATE_HOME, ".rasklad-setup.lock"),
               os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
  try:
    if not stat.S_ISREG(os.fstat(fd).st_mode):
      raise Refused("the lock file is not a regular file")
    fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
  except BlockingIOError:
    os.close(fd)
    raise Refused("another rasklad-setup is running")
  except BaseException:
    os.close(fd)
    raise
  return fd


def new_state():
  return {"version": 1, "files": {}, "link": None, "fcitx": None}


def load_state():
  data = read(STATE_FILE)
  if data is None:
    return new_state()
  try:
    state = json.loads(data)
  except ValueError:
    raise Refused("the state file is damaged: %s" % STATE_FILE)
  if not isinstance(state, dict) or state.get("version") != 1:
    raise Refused("unknown state file: %s" % STATE_FILE)
  # Only paths this tool itself would ever record are trusted.
  bad = Refused("unexpected entry in the state file: %s" % STATE_FILE)
  if set(state) - {"version", "files", "link", "fcitx", "await_hypr", "hypr_layout", "input_block"} or \
     not isinstance(state.get("files"), dict):
    raise bad
  if not isinstance(state.get("await_hypr", False), bool):
    raise bad
  ib = state.get("input_block")
  if ib is not None and not (isinstance(ib, str) and re.fullmatch(r"[0-9a-f]{64}", ib)):
    raise bad
  hl = state.get("hypr_layout")
  if hl is not None and not (isinstance(hl, str) and hl and XKB.fullmatch(hl)):
    raise bad
  for path, entry in state["files"].items():
    if path not in FILES or not isinstance(entry, dict) or \
       entry.get("backup") != backup_path(path) or entry.get("bak") != path + ".rasklad.bak" or \
       not isinstance(entry.get("bak_ours", False), bool) or \
       not (isinstance(entry.get("written"), str) and re.fullmatch(r"[0-9a-f]{64}", entry["written"])):
      raise bad
  if state.get("link") not in (None, WIDGET):
    raise bad
  saved = state.get("fcitx")
  items = lambda v: isinstance(v, list) and all(
    isinstance(i, list) and len(i) == 2 and all(isinstance(x, str) for x in i) for i in v)
  if isinstance(saved, dict) and set(saved) != {"groups"}:
    # Written before SYS-272 (a snapshot): ours are only the required methods in
    # after that were not in before, and only as this tool writes them (with no
    # layout of their own). Anything else there was the user's.
    if not (isinstance(saved.get("group"), str) and items(saved.get("before")) and
            items(saved.get("after"))):
      raise bad
    had = set(ids(saved["before"]))
    rows = [r for r in saved["after"] if r[0] in REQUIRED and r[0] not in had and r[1] == ""]
    if not isinstance(saved.get("after_layout", saved.get("layout")), str):
      raise bad
    entry = {"added": rows, "legacy_after": saved["after"], "legacy_before": saved["before"],
             "legacy_layout": saved.get("after_layout", saved.get("layout"))}
    state["fcitx"] = {"groups": {saved["group"]: entry}} if rows else None
  elif saved is not None:
    groups = saved.get("groups") if isinstance(saved, dict) else None
    if not (isinstance(groups, dict) and groups and all(
        isinstance(k, str) and isinstance(v, dict) and set(v) - {"legacy_after", "legacy_before", "legacy_layout"} == {"added"} and
        len({"legacy_after", "legacy_before", "legacy_layout"} & set(v)) in (0, 3) and
        isinstance(v.get("legacy_layout", ""), str) and
        items(v["added"]) and items(v.get("legacy_after", [])) and items(v.get("legacy_before", [])) and
        v["added"] and all(r[0] in REQUIRED and r[1] == "" for r in v["added"]) for k, v in groups.items())):
      raise bad
  return state


def save_state(state):
  private_state_dir()
  # Keys starting with "_" are this run's working notes (the copies to delete
  # once saved), never part of the file.
  data = {k: v for k, v in state.items() if not k.startswith("_")}
  write_atomic(STATE_FILE, (json.dumps(data, indent=2, sort_keys=True) + "\n").encode(), 0o600)


def save_and_drop(state):
  # Restored files' private copies are deleted only after the state without
  # their entries is on disk, so an interruption never strands an entry.
  drop = state.pop("_drop", [])
  save_state(state)
  for backup in drop:
    if backup not in {backup_path(f) for f in FILES}:
      continue  # only this tool's own copies of its own files
    try:
      os.unlink(backup)
    except FileNotFoundError:
      pass


def backup_path(path):
  return os.path.join(BACKUP_DIR, hashlib.sha256(path.encode()).hexdigest()[:16])


# --- Hyprland -----------------------------------------------------------------

def run(argv, timeout=5):
  try:
    return subprocess.run(argv, capture_output=True, text=True, timeout=timeout)
  except (OSError, subprocess.TimeoutExpired):
    return None


def hypr_option(name):
  done = run([HYPRCTL, "getoption", name, "-j"])
  if not done or done.returncode != 0:
    return None
  try:
    value = json.loads(done.stdout).get("str")
  except (ValueError, AttributeError):
    return None
  return value if isinstance(value, str) else None


def hypr_running():
  done = run([HYPRCTL, "version", "-j"])
  return bool(done and done.returncode == 0)


def hypr_session():
  """running, none (no Hyprland session here) or unknown (a session that does
  not answer: it may still run with one layout)."""
  if hypr_running():
    return "running"
  if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
    return "unknown"
  # From a TTY or SSH: hyprctl finds instances by their sockets, so do we.
  runtime = os.environ.get("XDG_RUNTIME_DIR") or "/run/user/%d" % os.getuid()
  try:
    names = os.listdir(os.path.join(runtime, "hypr"))
  except OSError:
    names = []
  for n in names:
    path = os.path.join(runtime, "hypr", n, ".socket.sock")
    if not os.path.exists(path):
      continue
    probe = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    probe.settimeout(1)
    try:
      probe.connect(path)
    except (ConnectionRefusedError, FileNotFoundError):
      continue  # left behind by a Hyprland that is gone
    except OSError:
      return "unknown"
    finally:
      probe.close()
    return "unknown"  # a live Hyprland this shell cannot query
  return "none"


def hypr_errors():
  done = run([HYPRCTL, "configerrors", "-j"])
  if not done or done.returncode != 0:
    return None
  try:
    errors = json.loads(done.stdout)
  except ValueError:
    return None
  return sorted(e for e in errors if isinstance(e, str) and e.strip()) if isinstance(errors, list) else None


# --- Fcitx over D-Bus (only method names and input method ids) ---------------

def fcitx():
  try:
    from gi.repository import Gio, GLib
  except ImportError:
    return None
  try:
    bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
  except GLib.Error:
    return None

  def call(method, args=None, reply="()"):
    try:
      return bus.call_sync("org.fcitx.Fcitx5", "/controller", "org.fcitx.Fcitx.Controller1", method,
                           args, GLib.VariantType(reply), Gio.DBusCallFlags.NO_AUTO_START, 2000,
                           None).unpack()
    except GLib.Error:
      return None

  def group_by(name):
    # None when Fcitx does not answer or has no group of that name.
    names = call("InputMethodGroups", None, "(as)")
    if not names or name not in names[0]:
      return None
    info = call("InputMethodGroupInfo", GLib.Variant("(s)", (name,)), "(sa(ss))")
    if not info:
      return None
    return name, info[0], [list(item) for item in info[1]]

  def group():
    name = call("CurrentInputMethodGroup", None, "(s)")
    return group_by(name[0]) if name else None

  def groups():
    names = call("InputMethodGroups", None, "(as)")
    return list(names[0]) if names else None

  def set_group(name, layout, items):
    return call("SetInputMethodGroupInfo",
                GLib.Variant("(ssa(ss))", (name, layout, [tuple(i) for i in items]))) is not None

  def status():
    reply = call("GetConfig", GLib.Variant("(s)", ("fcitx://config/addon/rasklad/status",)),
                 "(va(sa(sssva{sv})))")
    values = reply[0] if reply else None
    return values if isinstance(values, dict) else None

  return {"group": group, "group_by": group_by, "groups": groups, "set_group": set_group, "status": status}


def ids(items):
  return sorted(i[0] for i in items)


# SYS-272: the Fcitx record holds, per group name, the rows (method, its own
# layout) this tool added, never a snapshot of the whole group. Undoing removes
# those rows if they are still there exactly, and keeps everything else as it is
# now: the user's other methods, their order and the group's default layout.
REQUIRED = ("keyboard-us", "keyboard-ru")


def claimed_groups(state):
  return dict((state.get("fcitx") or {}).get("groups", {}))


def claimed_rows(state, name):
  entry = claimed_groups(state).get(name)
  return [list(r) for r in entry["added"]] if entry else []


def set_claim(state, name, rows):
  groups = claimed_groups(state)
  if rows:
    groups[name] = {"added": [list(r) for r in rows]}
  else:
    groups.pop(name, None)
  state["fcitx"] = {"groups": groups} if groups else None


def still_ours(rows, items):
  # A row the user removed, or gave another layout, is no longer ours; nor is
  # one the group holds twice (which of them is ours cannot be told).
  return [r for r in rows if items.count(r) == 1]


def legacy_unmatched(entry, layout, items):
  # An older install's record counts on its group as it left it (after); a group
  # back as it was before (never applied, or restored) has nothing of ours.
  return items != entry["legacy_after"] and items != entry["legacy_before"] or \
    items == entry["legacy_after"] and layout != entry["legacy_layout"]


def settle_claim(state, name, layout, items):
  """Bring the record for this group up to what Fcitx shows now: rows of ours the
  user removed or changed are theirs from here on. A record converted from an
  older version only counts if the group is still exactly as that install left
  it (as the older --revert required); otherwise its rows are left as they are.
  Returns True when the record changed; the caller saves it."""
  entry = claimed_groups(state).get(name)
  if not entry:
    return False
  rows = [list(r) for r in entry["added"]]
  if "legacy_after" in entry:
    if legacy_unmatched(entry, layout, items):
      say("changed", "fcitx-group", "changed since an older install; its layouts left as is")
      rows = []
  set_claim(state, name, still_ours(rows, items))
  return claimed_groups(state).get(name) != entry


# --- the steps: (state, new bytes) --------------------------------------------

def lua_ok(data):
  # The edited file must still compile (a file ending in "return ..." would
  # not with a block after it). luac comes with lua, which Hyprland needs; if
  # it is missing, Hyprland's own config check after the reload decides.
  try:
    done = subprocess.run(["/usr/bin/luac", "-p", "-"], input=data, capture_output=True, timeout=5)
  except FileNotFoundError:
    return True
  except (OSError, subprocess.TimeoutExpired):
    return False
  return done.returncode == 0


def append_block(data, block):
  sep = b"" if not data or data.endswith(b"\n") else b"\n"
  return data + sep + block.encode()


def file_state(path):
  # Only a regular file reached without any symlink (a dotfiles checkout, a
  # symlinked ~/.config) is ever read for editing or written.
  try:
    info = os.lstat(path)
  except FileNotFoundError:
    return "missing-file"
  if stat.S_ISLNK(info.st_mode) or os.path.realpath(path) != os.path.abspath(path):
    return "symlink"
  return None if stat.S_ISREG(info.st_mode) else "not-a-file"


def bindings_plan(data=None):
  bad = file_state(BINDINGS)
  if bad:
    return bad, None
  if data is None:
    data = read(BINDINGS)
  text = data.decode(errors="replace")
  if BEGIN in text or RULE_LINE.search(text):
    return "ok", None
  block = ("\n%s: two quick left-Alt taps switch the Fcitx layout us <-> ru.\n"
           "-- Loaded only while the package is installed; remove with rasklad-setup --revert.\n"
           "local rasklad = \"%s\"\n"
           "local found = io.open(rasklad, \"r\")\n"
           "if found then found:close(); dofile(rasklad) end\n"
           "%s\n") % (BEGIN, RULE, END)
  new = append_block(data, block)
  return ("missing", new) if lua_ok(new) else ("lua-error", None)


def layout_block(data):
  """Our BEGIN..END block in input.lua, or None."""
  if BEGIN.encode() not in data:
    return None
  start = data.index(BEGIN.encode())
  end = data.find(END.encode(), start)
  return data[start:end] if end != -1 else b""


def input_plan(data=None, written=None):
  # written: the hash of the block this tool wrote (SYS-272); a block of ours
  # with another variant or options is the user's edit, not ours as is.
  """Hyprland keeps one layout and no xkb group toggle: Fcitx switches layouts."""
  bad = file_state(INPUT)
  if bad:
    return bad, None
  if data is None:
    data = read(INPUT)
  if BEGIN.encode() in data:
    # Decided by the file, not by what Hyprland has loaded. Only a block this
    # version wrote is ours as is: the mark and kb_layout = "us" inside the same
    # BEGIN..END block. Anything else (written before SYS-268, which may have
    # kept ru or dropped kz, or edited since) is reported for revert and reinstall.
    block = layout_block(data)
    if not LAYOUT_BLOCK_RE.fullmatch(block):
      return "legacy", None
    return ("edited", None) if written and sha(block) != written else ("ok", None)
  layout, options, variant = (hypr_option("input:" + k) for k in ("kb_layout", "kb_options", "kb_variant"))
  if layout is None or options is None or variant is None:
    return "unknown", None
  # XKB ignores spaces around the commas ("compose:caps, grp:alt_shift_toggle").
  opts = [o.strip() for o in options.split(",") if o.strip()]
  kept = [o for o in opts if not o.startswith("grp:")]
  if "," not in layout and len(kept) == len(opts):
    # SYS-272: one layout and no switch key. us is what this step would leave;
    # any other single layout is the user's, and the reason is said.
    return ("ok", None) if layout.strip() in ("", "us") else ("single", None)
  # SYS-268: Hyprland keeps us, wherever it is in the list: the lock screen reads
  # its password with Hyprland's layout, and Fcitx never reaches it. Exactly us
  # and ru, or nothing changes: kz, de or a second us would be lost.
  layouts = [l.strip() for l in layout.split(",")]
  if sorted(layouts) not in (["us"], ["ru", "us"]):
    return "other-layouts", None
  variants = variant.split(",")
  i = layouts.index("us")
  values = ("us", variants[i].strip() if i < len(variants) else "", ",".join(kept))
  if values[1] not in LATIN_US:
    # us(rus) and the like type Cyrillic: the lock screen would have no Latin.
    return "other-layouts", None
  if not all(XKB.fullmatch(v) for v in values):
    # Only this optional step is affected; the rest of --install goes on.
    return "unknown", None
  block = "\n" + LAYOUT_BLOCK.replace("{variant}", values[1]).replace("{options}", values[2]) + END + "\n"
  new = append_block(data, block)
  return ("missing", new) if lua_ok(new) else ("lua-error", None)


def shell_plan(data=None):
  bad = file_state(SHELL_JSON)
  if bad:
    return bad, None
  if data is None:
    data = read(SHELL_JSON)
  try:
    json.loads(data)
  except ValueError:
    return "unparsable", None
  if names_widget(data):
    return "ok", None
  # Exactly one stock widget, and it sits in the bar's layout.
  found = []

  def walk(node, where):
    if isinstance(node, dict):
      if node.get("id") == "omarchy.keyboard-layout":
        found.append(where)
      for key, value in node.items():
        walk(value, where + [key])
    elif isinstance(node, list):
      for value in node:
        walk(value, where)

  walk(json.loads(data), [])
  if len(STOCK_ID.findall(data)) != 1 or len(found) != 1 or found[0][:2] != ["bar", "layout"]:
    return "no-slot", None
  new = STOCK_ID.sub(rb'\1"rasklad.layout"', data)
  json.loads(new)
  return "missing", new


def link_state():
  if os.path.islink(PLUGIN_LINK):
    return "ok" if os.readlink(PLUGIN_LINK) == WIDGET else "other"
  return "other" if os.path.lexists(PLUGIN_LINK) else "missing"


def fcitx_plan(bus, current=False):
  # current: a group already read (one snapshot for the plan and the record).
  if current is False:
    current = bus["group"]() if bus else None
  if current is None:
    return "no-fcitx", None
  name, layout, items = current
  missing = [m for m in ("keyboard-us", "keyboard-ru") if m not in ids(items)]
  if not missing:
    return "ok", None
  return "missing", (name, layout, items, items + [[m, ""] for m in missing])


# --- modes --------------------------------------------------------------------

def check():
  ok = True

  def report(state, step, note=""):
    nonlocal ok
    ok = ok and state == "ok"
    say(state, step, note)

  report("ok" if os.path.isfile(RULE) and os.path.isdir(WIDGET) else "missing", "package")
  bus = fcitx()
  status = bus["status"]() if bus else None
  if status is None:
    report("missing", "fcitx-addon", "Fcitx not running or Rasklad not loaded")
  else:
    report("ok" if status.get("ProfileReady") == "True" else "broken", "fcitx-addon")
    say("on" if status.get("AutoCorrect") == "True" else "paused", "auto-correction")
  report(fcitx_plan(bus)[0], "fcitx-group")
  report(bindings_plan()[0], "double-alt")
  try:
    written = load_state().get("input_block")
  except Refused:
    written = None
  state = input_plan(None, written)[0]
  if state == "edited":
    say("edited", "hyprland-layout", EDITED_ADVICE)  # the user's choice, not a fault
  elif state == "unknown":
    say("unknown", "hyprland-layout", "Hyprland not running or its keyboard options not readable")
  elif state == "missing":
    # SYS-268: a choice, not a fault. Hyprland keeps its layouts and switch.
    say("optional", "hyprland-layout", "Hyprland keeps its layouts; --install --single-layout leaves only us")
  elif state == "lua-error":
    say("optional", "hyprland-layout", "Hyprland keeps its layouts; input.lua would not compile with the block")
  elif state == "single":
    say("ok", "hyprland-layout", "one layout that is not us, no switch key; left as is")
  elif state == "other-layouts":
    say("other-layouts", "hyprland-layout", "not exactly us and ru, or a us variant that is not Latin; Hyprland keeps them")
  elif state == "legacy":
    report("legacy", "hyprland-layout", LEGACY_ADVICE)
  else:
    report(state, "hyprland-layout")
  report(link_state(), "bar-widget-link")
  report(shell_plan()[0], "bar-widget")
  return 0 if ok else 1


def show_diff(path, old, new):
  sys.stdout.writelines(difflib.unified_diff(
    old.decode(errors="replace").splitlines(True), new.decode(errors="replace").splitlines(True),
    path + " (now)", path + " (after)"))


def remember_file(state, path, old, new):
  # The first copy is the one --revert restores; a later run never replaces it.
  entry = state["files"].get(path)
  if entry is None:
    private_state_dir()
    write_atomic(backup_path(path), old, 0o600)
    bak = path + ".rasklad.bak"
    ours = not os.path.lexists(bak)
    if ours:
      write_atomic(bak, old, stat.S_IMODE(os.stat(path).st_mode))
    entry = state["files"][path] = {"backup": backup_path(path), "bak": bak, "bak_ours": ours}
  entry["written"] = sha(new)


def record_then_check(state, path, old, new):
  """SYS-272: the copy and the state are written first, so nothing but the
  rename follows the last comparison. If the file changed meanwhile, the record
  made here is taken back (an earlier record keeps its old hash)."""
  entry = state["files"].get(path)
  before = dict(entry) if entry else None
  bak_existed = os.path.lexists(path + ".rasklad.bak")
  block_before = state.get("input_block")
  if path == INPUT and layout_block(new):
    state["input_block"] = sha(layout_block(new))  # the block as written (SYS-272)
  remember_file(state, path, old, new)
  save_state(state)
  try:
    same = file_state(path) is None and read(path) == old
  except OSError:  # swapped for something unreadable meanwhile
    same = False
  if same:
    return True  # only the rename follows; a save in that instant is not seen
  if path == INPUT:
    if block_before is None:
      state.pop("input_block", None)
    else:
      state["input_block"] = block_before
  if before is not None:
    state["files"][path] = before
  else:
    made = state["files"].pop(path)
    if made.get("bak_ours", False) and not bak_existed and file_state(made["bak"]) is None and \
       read(made["bak"]) == old:
      os.unlink(made["bak"])
    state.setdefault("_drop", []).append(made["backup"])
  save_and_drop(state)
  return False


def names_widget(data):
  """shell.json names our widget anywhere (decoded JSON, so escapes count).
  Unparsable counts as yes: nothing is removed on a guess."""
  try:
    root = json.loads(data)
  except ValueError:
    return True
  stack = [root]
  while stack:
    node = stack.pop()
    if isinstance(node, dict):
      if node.get("id") == "rasklad.layout":
        return True
      stack.extend(node.values())
    elif isinstance(node, list):
      stack.extend(node)
  return False


def ours_in(path, data):
  """Does this file still carry our change? (SYS-270) Any trace counts: the
  BEGIN comment alone may have been taken out while what follows still runs."""
  if path == SHELL_JSON:
    return names_widget(data)
  # Lua files: every block version and the rule loader name rasklad (in a
  # comment, a variable or the rule's path, even split by concatenation as
  # "rasklad" .. "-fcitx5"). A file with every mention of rasklad taken out is
  # the user's own configuration, whatever it sets.
  return b"rasklad" in data.lower()


def forget_entry(state, path):
  """Drop a file's entry. Its private copy goes only if the .rasklad.bak beside
  the file is ours and the same; otherwise it is the only copy of the file from
  before install and is kept as *.before-reset, written before the state forgets
  it. Returns where the old copy is."""
  entry = state["files"].pop(path)
  if path == INPUT:
    state.pop("input_block", None)
  if entry.get("bak_ours", False) and file_state(entry["bak"]) is None and \
     read(entry["bak"]) == read(entry["backup"]):
    state.setdefault("_drop", []).append(entry["backup"])
    return entry["bak"]
  data = read(entry["backup"])
  if data is None:
    return entry["bak"]  # nothing left to keep
  # Copied first, so no moment exists where the only copy is untracked.
  kept = "%s.%s.before-reset" % (entry["backup"], sha(data)[:12])
  write_atomic(kept, data, 0o600)
  state.setdefault("_drop", []).append(entry["backup"])
  return kept


def drop_stale(state, paths):
  """SYS-270: a tracked file that no longer carries our change (omarchy refresh,
  or reset by hand) has nothing of ours to undo: its entry and private copy go,
  the .rasklad.bak beside it stays. Otherwise --install and --revert would stop
  on it for good."""
  dropped = False
  for path in paths:
    if path not in state["files"] or file_state(path) is not None:
      continue
    data = read(path)
    if data is None or ours_in(path, data):
      continue
    copy = forget_entry(state, path)
    say("reset", os.path.basename(path),
        "our change is gone (omarchy refresh?); nothing to undo (old copy: %s)" % copy)
    dropped = True
  if dropped:
    save_and_drop(state)


def install(assume_yes, single_layout=False):
  state = load_state()
  # SYS-270: a record whose file lost our change (omarchy refresh) is only noted
  # here; it is replaced at the moment the new change is written, after the last
  # comparison, so a "no" or a file restored meanwhile keeps it. input.lua is
  # never among them: its record is what makes --revert check the live layouts
  # before it removes the controls (SYS-268).
  stale = set()  # decided from the same bytes the preview shows, below
  changes = []
  layout_change = []  # SYS-268: its own question, never part of "Apply these changes?"
  # SYS-272: a step skipped for a fault (not the user's own setup, not the
  # optional input.lua step) makes the run exit 1, so "done" is never claimed.
  fault = False
  for path, plan in ((BINDINGS, bindings_plan), (INPUT, input_plan), (SHELL_JSON, shell_plan)):
    # One read: the diff, the backup and the final comparison all use it.
    bad = file_state(path)
    if bad:
      say(bad, os.path.basename(path), "left as is")
      fault = fault or path != INPUT
      continue
    old = read(path)
    if old is None:
      say("missing-file", os.path.basename(path), "left as is")
      fault = fault or path != INPUT
      continue
    status, new = input_plan(old, state.get("input_block")) if path == INPUT else plan(old)
    if path in (BINDINGS, SHELL_JSON) and path in state["files"] and not ours_in(path, old):
      stale.add(path)
    if status == "missing" and path in state["files"] and path not in stale:
      # Installed before and edited since: a second copy would let --revert
      # drop those edits. The user reverts first.
      say("changed", os.path.basename(path), "edited since an earlier install; run --revert first")
      fault = True
    elif status == "missing" and path == INPUT:
      layout_change.append((path, old, new))
    elif status == "missing":
      changes.append((path, old, new))
    elif status == "unknown":
      say("unknown", os.path.basename(path), "Hyprland not running; skipped")
    elif status == "single":
      say("kept", os.path.basename(path), "Hyprland has one layout that is not us and no switch key; left as is")
    elif status == "other-layouts":
      say("other-layouts", os.path.basename(path),
          "not exactly us and ru, or a us variant that is not Latin: Hyprland keeps its layouts and switch; left as is")
    elif status == "legacy":
      say("legacy", os.path.basename(path), LEGACY_ADVICE)
      fault = True
    elif status == "edited":
      say("edited", os.path.basename(path), EDITED_ADVICE)
    elif status != "ok":
      say(status, os.path.basename(path), "left as is")
      fault = fault or path != INPUT  # lua-error, no-slot, unparsable
  link = link_state()
  if link == "other":
    say("other", "bar-widget-link", "something else is there; left as is")
  bus = fcitx()
  live = bus["group"]() if bus else None
  group = fcitx_plan(bus, live)
  if group[0] == "no-fcitx":
    say("no-fcitx", "fcitx-group", "start Fcitx and run again")
    fault = True
    # SYS-268: without Fcitx nothing else would switch layouts.
    if layout_change:
      say("skipped", os.path.basename(INPUT), "Hyprland layouts left as is until Fcitx runs")
      layout_change = []

  # SYS-272: what this run sees is settled at once: a row of ours the user
  # removed is theirs if it comes back, even while the question waits.
  if live and settle_claim(state, live[0], live[1], live[2]):
    save_state(state)

  main_steps = bool(changes) or link == "missing" or group[0] == "missing"
  if not main_steps and not layout_change:
    if fault:
      print("Not everything is connected; see the lines above.")
      return 1
    print("Nothing to change.")
    return 0
  if main_steps:
    for path, old, new in changes:
      show_diff(path, old, new)
    if link == "missing":
      print("+ link %s -> %s" % (PLUGIN_LINK, WIDGET))
    if group[0] == "missing":
      print("+ Fcitx group %s: add %s" % (group[1][0], ", ".join(
        sorted(set(ids(group[1][3])) - set(ids(group[1][2]))))))
    if not assume_yes:
      if not sys.stdin.isatty():
        raise Refused("not a terminal: pass --yes to apply")
      if input("Apply these changes? [y/N] ").strip().lower() not in ("y", "yes"):
        print("Nothing changed.")
        return 0

  # SYS-268: keeping only us in Hyprland is the user's choice, asked on its own:
  # the lock screen reads the password with Hyprland's layout, never Fcitx's.
  if layout_change:
    path, old, new = layout_change[0]
    show_diff(path, old, new)
    print("  Hyprland keeps only the us layout; Fcitx switches layouts in apps.\n"
          "  The lock screen then takes the password in the us (Latin) layout only.")
    if assume_yes:
      if not single_layout:
        say("skipped", os.path.basename(path), "Hyprland keeps its layouts; pass --single-layout to keep only us")
        layout_change = []
    elif not sys.stdin.isatty():
      raise Refused("not a terminal: pass --yes --single-layout to keep only us")
    else:
      # Asked even with --single-layout; the flag only makes yes the default.
      answer = input("Keep only the us layout in Hyprland? [%s] " % ("Y/n" if single_layout else "y/N"))
      answer = answer.strip().lower()
      if not (answer in ("y", "yes") or (single_layout and answer == "")):
        say("skipped", os.path.basename(path), "Hyprland keeps its layouts")
        layout_change = []

  # Each step is recorded before it is done, so a crash in between leaves a
  # state --revert can reconcile (an unwritten file still equals its copy).
  errors_before = hypr_errors()
  failed = False
  input_change = layout_change
  for path, old, new in changes:
    # The file must still be exactly what the diff was made from.
    if file_state(path) is not None or read(path) != old:
      say("changed", os.path.basename(path), "edited while waiting; left as is")
      failed = True
      continue
    if path in stale:
      copy = forget_entry(state, path)
      say("reset", os.path.basename(path),
          "our change was gone (omarchy refresh?); old copy: %s" % copy)
      save_and_drop(state)
    tmp = prepare_atomic(path, new)
    if not record_then_check(state, path, old, new):
      discard(tmp)
      say("changed", os.path.basename(path), "edited while waiting; left as is")
      failed = True
      continue
    commit_atomic(tmp, path)
    say("done", os.path.basename(path))
  if link == "missing":
    state["link"] = WIDGET
    save_state(state)
    os.makedirs(os.path.dirname(PLUGIN_LINK), exist_ok=True)
    try:
      os.symlink(WIDGET, PLUGIN_LINK)
      say("done", "bar-widget-link")
    except FileExistsError:
      # Made by something else meanwhile: not ours, so --revert leaves it.
      state["link"] = None
      save_state(state)
      say("other", "bar-widget-link", "something else appeared there; left as is")
      failed = True
  run_rows, fcitx_name = [], None
  if group[0] == "missing":
    # SYS-272: read again now, not the group from before the question, so a
    # change made while it waited is kept; the default layout is passed through.
    now = bus["group"]()
    if now and settle_claim(state, now[0], now[1], now[2]):
      save_state(state)  # whichever group this is: what is seen is settled
    if now is None:
      say("no-fcitx", "fcitx-group", "start Fcitx and run again")
      failed = True
    elif now[0] != group[1][0]:
      say("changed", "fcitx-group", "another group became current while waiting; left as is")
      failed = True
    elif all(m in ids(now[2]) for m in REQUIRED):
      say("ok", "fcitx-group", "both layouts are there already")
    else:
      name, layout, items = now
      new = [[m, ""] for m in REQUIRED if m not in ids(items)]
      fcitx_name = name
      # Settled against this read just above; new rows are missing now, so
      # never among them. Recorded before the write: an interruption after it
      # still lets --revert take these rows out.
      kept = claimed_rows(state, name)
      set_claim(state, name, kept + new)
      save_state(state)
      replied = bus["set_group"](name, layout, items + new)
      back = bus["group_by"](name)
      if back is None:
        # Outcome unknown: the claim stays, so --revert can still remove them.
        say("unknown", "fcitx-group", "Fcitx did not answer; run --check")
        failed = True
      else:
        run_rows = [r for r in new if back[2].count(r) == 1]  # twice: not ours
        set_claim(state, name, still_ours(kept, back[2]) + run_rows)
        save_state(state)
        if replied and len(run_rows) == len(new):
          say("done", "fcitx-group")
        else:
          say("failed", "fcitx-group")
          failed = True
  for path, old, new in input_change:
    # The group as Fcitx has it now, not the snapshot from before the question:
    # a successful reply does not prove both layouts are there.
    final_bus = fcitx()
    final = final_bus["group"]() if final_bus else None
    if final and settle_claim(state, final[0], final[1], final[2]):
      save_state(state)  # a removal seen here makes a re-added row the user's
    if fcitx_plan(final_bus, final)[0] != "ok":
      say("skipped", os.path.basename(path), "Fcitx does not have both layouts; Hyprland layouts left as is")
      failed = True
      continue
    if path == INPUT:
      # What "the user's layouts are back" means for --revert (SYS-268); asked
      # before the file comparison below, so nothing waits between it and the write.
      recorded = "".join((hypr_option("input:kb_layout") or "").split())
    if path == INPUT and input_plan(old, state.get("input_block")) != ("missing", new):
      say("changed", os.path.basename(path), "Hyprland layouts changed while waiting; left as is")
      failed = True
      continue
    if path == INPUT:
      state["hypr_layout"] = recorded if recorded and XKB.fullmatch(recorded) else None
    # After the Hyprland queries above: a save made meanwhile is not overwritten.
    tmp = prepare_atomic(path, new)
    if not record_then_check(state, path, old, new):
      discard(tmp)
      say("changed", os.path.basename(path), "edited while waiting; left as is")
      failed = True
      continue
    commit_atomic(tmp, path)
    say("done", os.path.basename(path))
    changes.append((path, old, new))

  # Hyprland reloads a saved config by itself. Only errors that were not there
  # before undo our edits, and only the files this run changed.
  hypr = [p for p, _, _ in changes if p in (BINDINGS, INPUT)]
  if hypr and hypr_running():
    run([HYPRCTL, "reload"])
    errors = hypr_errors()
    if errors and errors != errors_before:
      # With no answer before the change, any error now is taken as ours: undoing
      # our own edits is the safe side.
      say("error", "hyprland", "new config errors after the change; undoing it" if errors_before is not None
          else "config errors after the change (none could be read before); undoing it")
      # SYS-268: input.lua first; while it keeps one layout, double Alt stays.
      if INPUT in hypr and not restore(state, INPUT):
        say("kept", "rasklad-controls", "input.lua not restored; double Alt kept")
      elif INPUT in hypr and not hypr_layouts_back(state):
        state["await_hypr"] = True
        say("kept", "rasklad-controls", "Hyprland has not taken the restored input.lua; run --revert")
      else:
        for path in hypr:
          if path != INPUT:
            restore(state, path)
        run([HYPRCTL, "reload"])
        # SYS-272: Fcitx's group goes back to what it was before this run, only
        # if this run changed it and no block of ours still keeps Hyprland at us.
        # The bar widget switches between the two Fcitx methods: while shell.json
        # uses it, both stay, or its click would do nothing.
        if run_rows and INPUT not in state["files"] and not state.get("await_hypr"):
          if shell_uses_widget():
            say("kept", "fcitx-group", "the bar widget switches between both layouts; kept")
          else:
            undo_group(state, fcitx_name, run_rows)
      save_and_drop(state)
      return 1
    if errors is None:
      say("unverified", "hyprland", "Hyprland did not report its config errors after the change")
  if fault and not failed:
    print("Not everything is connected; see the lines above.")
  return 1 if failed or fault else 0


def restore(state, path):
  entry = state["files"].get(path)
  if not entry:
    return True
  old = read(entry["backup"])
  if old is None:
    say("missing", os.path.basename(path), "the saved copy is gone; left as is")
    return False
  bad = file_state(path)
  if bad not in (None, "missing-file"):
    say(bad, os.path.basename(path), "left as is")
    return False
  # Ready before the comparison: only the rename follows it (SYS-272).
  tmp = prepare_atomic(path, old) if bad is None else None
  try:
    current = read(path)
  except BaseException:
    if tmp:
      discard(tmp)
    raise
  if current is not None and current == old:
    if tmp:
      discard(tmp)  # never written (an interrupted install), or already restored
  elif current is None:
    # SYS-272: deleted since install: our change went with it. The entry is
    # forgotten (its copy kept), so revert can finish and install run again.
    copy = forget_entry(state, path)
    say("gone", os.path.basename(path), "deleted since install; nothing to put back (old copy: %s)" % copy)
    return True
  elif sha(current) != entry["written"]:
    if tmp:
      discard(tmp)
    say("changed", os.path.basename(path), "edited since install; left as is (copy: %s)" % entry["bak"])
    return False
  else:
    commit_atomic(tmp, path)
  bak = entry["bak"]
  if entry.get("bak_ours", False) and file_state(bak) is None and read(bak) == old:
    os.unlink(bak)
  # The private copy goes only after the state without this entry is saved.
  state.setdefault("_drop", []).append(entry["backup"])
  del state["files"][path]
  if path == INPUT:
    state.pop("input_block", None)
  say("restored", os.path.basename(path))
  return True


def hypr_reloaded():
  """hyprctl reload answers ok even when a config error leaves the previous
  config in force, so the reload counts only with no config errors after it."""
  done = run([HYPRCTL, "reload"])
  if not (done and done.returncode == 0):
    return False
  return hypr_errors() == []


def hypr_layouts_back(state):
  """After restoring input.lua: Hyprland reloaded and runs with the user's own
  layouts again: the ones it had when the block was written, or several. One us
  with only a group toggle left would not type Cyrillic."""
  done = run([HYPRCTL, "reload"])
  if done is None or done.returncode != 0:
    return False
  layout, options = hypr_option("input:kb_layout"), hypr_option("input:kb_options")
  if layout is None or options is None:
    return False
  layout = "".join(layout.split())
  if "," in layout:
    return True
  # One layout: the block was only ever written over it with a group toggle
  # (input_plan), and the block removes that toggle, so the toggle must be back.
  toggle = any(o.strip().startswith("grp:") for o in options.split(","))
  recorded = state.get("hypr_layout")
  return toggle and (recorded is None or layout == recorded)


def shell_uses_widget():
  """Read through a dotfiles symlink too. Unreadable counts as in use."""
  if file_state(SHELL_JSON) == "missing-file":
    return False
  try:
    fd = os.open(SHELL_JSON, os.O_RDONLY | os.O_NONBLOCK | os.O_CLOEXEC)
  except FileNotFoundError:
    return False  # a dangling link: nothing names the widget
  except OSError:
    return True
  try:
    if not stat.S_ISREG(os.fstat(fd).st_mode):
      os.close(fd)
      return True
  except OSError:
    os.close(fd)
    return True
  with os.fdopen(fd, "rb") as f:
    try:
      return names_widget(f.read())
    except OSError:
      return True


def input_block_present():
  # Opened without blocking and checked on the open file: a path swapped for a
  # FIFO in between cannot stall revert.
  try:
    fd = os.open(INPUT, os.O_RDONLY | os.O_NONBLOCK | os.O_CLOEXEC)
  except OSError:
    return False
  try:
    if not stat.S_ISREG(os.fstat(fd).st_mode):
      return False
    with os.fdopen(fd, "rb") as f:
      fd = None
      data = f.read()
    return ours_in(INPUT, data)
  except OSError:
    return False
  finally:
    if fd is not None:
      os.close(fd)


def undo_group(state, name, rows):
  """Auto-rollback of this run's Fcitx change: only the rows this run added that
  are still ours are taken out of the group as it is now; whatever else is
  recorded stays recorded, settled against that same read."""
  bus = fcitx()
  now = bus["group_by"](name) if bus else None
  if now is None:
    say("kept", "fcitx-group", "Fcitx did not answer; run --revert later")
    return
  _, layout, items = now
  settle_claim(state, name, layout, items)
  # A row this run saw removed is the user's if it is back: not ours any more.
  claim = claimed_rows(state, name)
  rows = [r for r in rows if r in claim]
  if not rows:
    return
  remaining = [i for i in items if i not in rows]
  if not remaining:
    say("kept", "fcitx-group", "the group would be left empty; left as is")
    return
  bus["set_group"](name, layout, remaining)
  # A reply does not prove the rows are gone: only a read does.
  back = bus["group_by"](name)
  if back is None:
    say("failed", "fcitx-group")
    return
  settle_claim(state, name, back[1], back[2])  # row by row: gone ones are done
  say("restored" if not any(r in back[2] for r in rows) else "failed", "fcitx-group")


def restore_fcitx(state):
  """Take the rows this tool added out of each recorded group, if they are
  still there; everything else in the group stays as it is now. Returns True
  when nothing of ours is left recorded."""
  # The bar widget switches between the two methods: while shell.json still
  # uses it (the user's own setting now), both stay.
  if shell_uses_widget():
    say("kept", "fcitx-group", "shell.json still uses the bar widget, which needs both layouts; kept")
    return False
  bus = fcitx()
  names = bus["groups"]() if bus else None
  if names is None:
    say("no-fcitx", "fcitx-group", "start Fcitx and run --revert again")
    return False
  clean = True
  for name in list(claimed_groups(state)):
    if name not in names:
      say("reset", "fcitx-group", "the group %s is gone; nothing to undo there" % name)
      set_claim(state, name, [])
      continue
    now = bus["group_by"](name)
    if now is None:
      say("no-fcitx", "fcitx-group", "start Fcitx and run --revert again")
      clean = False
      continue
    _, layout, items = now
    entry = claimed_groups(state)[name]
    if "legacy_after" in entry and legacy_unmatched(entry, layout, items):
      clean = False  # said by settle_claim; the next --revert finds nothing to do
    settle_claim(state, name, layout, items)
    ours = claimed_rows(state, name)
    remaining = [i for i in items if i not in ours]
    if not ours:
      set_claim(state, name, [])  # already gone, or changed by the user: theirs now
    elif not remaining:
      say("kept", "fcitx-group", "taking out ours would leave the group %s empty; left as is" % name)
      clean = False
    else:
      bus["set_group"](name, layout, remaining)
      back = bus["group_by"](name)  # a reply does not prove the rows are gone
      if back is not None:
        settle_claim(state, name, back[1], back[2])  # row by row: gone ones are done
      if back is not None and not claimed_rows(state, name):
        say("restored", "fcitx-group")
      else:
        say("failed", "fcitx-group")
        clean = False
  return clean


def revert():
  if read(STATE_FILE) is None:
    print("Nothing to revert.")
    return 0
  state = load_state()
  # SYS-270: input.lua is left to the SYS-268 checks below, which keep the
  # controls until Hyprland shows the user's layouts.
  drop_stale(state, (BINDINGS, SHELL_JSON))
  clean = True
  restored_hypr = False
  # SYS-268: input.lua first. While it still keeps one Hyprland layout, the
  # double Alt rule, the bar widget and Fcitx's layouts are the only ways to
  # switch, so they all stay until a later --revert restores it.
  had_input = INPUT in state["files"]
  try:
    input_kept = had_input and not restore(state, INPUT)
  except OSError as e:  # unreadable input.lua or its directory
    say("unreadable", os.path.basename(INPUT), "left as is (%s)" % e.strerror)
    input_kept = True
  input_left = False
  # Kept only while a readable regular input.lua (through a dotfiles symlink
  # too) still holds our block. Gone, a dangling link, a directory, unreadable:
  # the live layouts decide. The path itself is never written here.
  block_gone = input_kept and not input_block_present()
  if block_gone and hypr_session() == "running" and hypr_reloaded():
    # Our block is gone (omarchy refresh, edited, deleted) and a running
    # Hyprland has reloaded without it: whatever layouts it has now come from
    # the user's own file, not from us. input.lua stays as it is.
    input_kept, input_left = False, True
    copy = forget_entry(state, INPUT)
    say("reset", os.path.basename(INPUT), "our block is gone; left as is (old copy: %s)" % copy)
  restored_hypr = had_input and not input_kept and not input_left
  session = hypr_session() if (restored_hypr or state.get("await_hypr")) else "none"
  if session != "none":
    if session == "unknown" or not hypr_layouts_back(state):
      # The file is back, but Hyprland still runs with one layout: the controls
      # stay until it has taken the restored file; a later --revert checks again.
      state["await_hypr"] = True
      say("kept", "rasklad-controls", "Hyprland has not taken the restored input.lua; run --revert again inside the Hyprland session")
      save_and_drop(state)
      return 1
    state.pop("await_hypr", None)
  if input_kept and block_gone:
    clean = False
    say("kept", "rasklad-controls",
        "our block is gone from input.lua; run --revert again inside the Hyprland session, with no config errors")
  elif input_kept:
    clean = False
    say("kept", "rasklad-controls", "input.lua edited; remove the rasklad-setup block from it and run --revert again")
  else:
    for path in list(state["files"]):
      done = restore(state, path)
      clean = done and clean
      restored_hypr = restored_hypr or (done and path == BINDINGS)
  if input_kept:
    pass
  elif state.get("link") and shell_uses_widget():
    # SYS-270: the bar still lists the widget; without the link it would show
    # an empty slot. The link goes once shell.json no longer names it.
    say("kept", "bar-widget-link", "shell.json still uses the widget; link kept")
    clean = False
  elif state.get("link"):
    if os.path.islink(PLUGIN_LINK) and os.readlink(PLUGIN_LINK) == WIDGET:
      os.unlink(PLUGIN_LINK)
      say("removed", "bar-widget-link")
      state["link"] = None
    elif not os.path.lexists(PLUGIN_LINK):
      state["link"] = None  # never made (an interrupted install), or removed
    else:
      say("changed", "bar-widget-link", "not our link any more; left as is")
      clean = False
  if state.get("fcitx") and input_kept:
    # SYS-268: Hyprland still keeps one layout; Fcitx's two stay until input.lua
    # is back, or nothing would switch layouts. The entry stays for a retry.
    say("kept", "fcitx-group", "input.lua not restored; layouts kept in Fcitx")
    clean = False
  elif state.get("fcitx"):
    clean = restore_fcitx(state) and clean
  save_and_drop(state)
  if clean:
    # Only what this tool made: its state file, then the directories if empty.
    os.unlink(STATE_FILE)
    for d in (BACKUP_DIR, STATE_DIR):
      try:
        os.rmdir(d)
      except OSError:
        pass
  if restored_hypr and hypr_running():
    run([HYPRCTL, "reload"])
  return 0 if clean else 1


def main(argv):
  flags = ("--yes", "--single-layout")
  args = [a for a in argv if a not in flags]
  if len(args) != 1 or args[0] not in ("--check", "--install", "--revert") or \
     (any(f in argv for f in flags) and args[0] != "--install") or len(set(argv)) != len(argv):
    print("usage: rasklad-setup --check | --install [--yes] [--single-layout] | --revert", file=sys.stderr)
    return 2
  try:
    if args[0] != "--check":
      lock = lock_state()  # noqa: F841 - held until exit
    if args[0] == "--install":
      return install("--yes" in argv, "--single-layout" in argv)
    return check() if args[0] == "--check" else revert()
  except Refused as error:
    print("refused: %s" % error, file=sys.stderr)
  except EOFError:
    print("failed: no answer (input closed); nothing was changed after the question", file=sys.stderr)
  except OSError as error:
    # The cause and the path, never file contents.
    print("failed: %s%s%s" % (error.__class__.__name__,
                              ": " + error.strerror if error.strerror else "",
                              " (%s)" % error.filename if error.filename else ""), file=sys.stderr)
  except (ValueError, KeyError) as error:
    print("failed: %s" % error.__class__.__name__, file=sys.stderr)
  return 1


if __name__ == "__main__":
  sys.exit(main(sys.argv[1:]))
