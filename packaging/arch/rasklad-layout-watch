#!/usr/bin/python3 -I
# SPDX-License-Identifier: MIT
# Rasklad bar widget helper (SYS-251): one long-lived process that asks Fcitx for
# the current input method and for Rasklad's read-only status, in-process over
# D-Bus, and prints one JSON line only when either changes:
# {"method": "keyboard-us", "correction": "on"}. Fcitx announces no layout change
# on the bus, so the method is polled. SYS-272 (battery): the Fcitx owner comes
# from NameOwnerChanged instead of a call per tick; the method is read every
# 500 ms, every 250 ms for 3 s after any change; the status every 2 s. Rasklad's
# own switches (rasklad-layout-toggle, rasklad-pause-toggle) send a Poke signal
# that makes it read both at once. Only the method name and two booleans are
# read, never text. It exits when the widget stops reading.
import json
import os
import re
import sys

from gi.repository import Gio, GLib

BUS = "org.fcitx.Fcitx5"
INTERFACE = "org.fcitx.Fcitx.Controller1"
ADDON = re.compile(r"^[a-z][a-z0-9_]{0,31}$")
METHOD = re.compile(r"^[A-Za-z0-9_.:-]{1,64}$")


def owner_of(bus):
  # The unique name currently owning Fcitx's well-known name, or "" when none.
  try:
    reply = bus.call_sync("org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus",
                          "GetNameOwner", GLib.Variant("(s)", (BUS,)), GLib.VariantType("(s)"),
                          Gio.DBusCallFlags.NO_AUTO_START, 1000, None)
  except GLib.Error:
    return ""
  return reply.unpack()[0]


def call(bus, owner, method, args, reply_type):
  # One Fcitx instance (its unique name), a checked reply type, never a start,
  # never a long wait. Returns None on any failure.
  try:
    reply = bus.call_sync(owner, "/controller", INTERFACE, method, args, GLib.VariantType(reply_type),
                          Gio.DBusCallFlags.NO_AUTO_START, 1000, None)
  except GLib.Error:
    return None
  return reply.unpack()


def current_method(bus, owner):
  reply = call(bus, owner, "CurrentInputMethod", None, "(s)")
  name = reply[0] if reply else ""
  return name if METHOD.match(name) else ""


def flag(values, key):
  value = values.get(key)
  return True if value == "True" else False if value == "False" else None


def correction(bus, owner, status):
  reply = call(bus, owner, "GetConfig", GLib.Variant("(s)", (status,)), "(va(sa(sssva{sv})))")
  values = reply[0] if reply else None
  if not isinstance(values, dict):
    return ""
  ready, auto = flag(values, "ProfileReady"), flag(values, "AutoCorrect")
  if ready is None or auto is None:
    return ""
  if not ready:
    return "broken"
  return "on" if auto else "paused"


FAST_MS, SLOW_MS, FAST_FOR, STATUS_EVERY_MS = 250, 500, 12, 2000
POKE_INTERFACE = "org.rasklad.Widget1"


def main():
  # Optional addon name (the closed lab registers it as "raskladlab").
  addon = sys.argv[1] if len(sys.argv) == 2 else "rasklad"
  if len(sys.argv) > 2 or not ADDON.match(addon):
    sys.exit(2)
  status = "fcitx://config/addon/%s/status" % addon
  bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
  loop = GLib.MainLoop()
  # fast: ticks left at FAST_MS; status_due: monotonic ms of the next status read.
  state = {"owner": "", "correction": "", "last": None, "fast": FAST_FOR,
           "status_due": 0, "timer": 0, "status_now": True}

  def now_ms():
    return GLib.get_monotonic_time() // 1000

  def schedule():
    if state["timer"]:
      GLib.source_remove(state["timer"])
    state["timer"] = GLib.timeout_add(FAST_MS if state["fast"] > 0 else SLOW_MS, tick)

  def tick():
    state["timer"] = 0
    if not state["owner"]:
      # Also covers a Fcitx that appeared before the subscription took effect.
      state["owner"] = owner_of(bus)
      state["status_now"] = bool(state["owner"])  # a Fcitx just found: its status now
    owner = state["owner"]
    method = current_method(bus, owner) if owner else ""
    if state["status_now"] or now_ms() >= state["status_due"] or not method:
      state["correction"] = correction(bus, owner, status) if method else ""
      state["status_due"] = now_ms() + STATUS_EVERY_MS
      state["status_now"] = False
    line = {"method": method, "correction": state["correction"]}
    if line != state["last"]:
      state["last"] = line
      state["fast"] = FAST_FOR
      try:
        sys.stdout.write(json.dumps(line) + "\n")
        sys.stdout.flush()
      except (BrokenPipeError, OSError):
        loop.quit()
        return False
    elif state["fast"] > 0:
      state["fast"] -= 1
    schedule()
    return False

  def wake():
    # Read both values now (a new Fcitx, or one of Rasklad's own switches).
    state["status_now"] = True
    state["fast"] = FAST_FOR
    if state["timer"]:
      GLib.source_remove(state["timer"])
      state["timer"] = 0
    tick()

  def owner_changed(_conn, _sender, _path, _iface, _signal, params):
    name, _old, new = params.unpack()
    if name == BUS:
      # Both values come from one Fcitx: a new owner invalidates the cached status.
      state["owner"] = new
      wake()

  def poked(*_):
    wake()

  def reader_gone(*_):
    loop.quit()
    return False

  bus.signal_subscribe("org.freedesktop.DBus", "org.freedesktop.DBus", "NameOwnerChanged",
                       "/org/freedesktop/DBus", BUS, Gio.DBusSignalFlags.NONE, owner_changed)
  bus.signal_subscribe(None, POKE_INTERFACE, "Poke", "/org/rasklad/Widget", None,
                       Gio.DBusSignalFlags.NONE, poked)
  # Stop as soon as the widget closes its end, even while nothing changes.
  GLib.io_add_watch(sys.stdout.fileno(), GLib.PRIORITY_DEFAULT, GLib.IO_ERR | GLib.IO_HUP, reader_gone)
  # Subscribed first, then the owner is looked up (in tick): a change in between
  # arrives as a queued NameOwnerChanged.
  tick()
  if not state["timer"]:
    return
  try:
    loop.run()
  except KeyboardInterrupt:
    pass


if __name__ == "__main__":
  main()
  # The reader may be gone: send the final interpreter flush nowhere.
  os.dup2(os.open(os.devnull, os.O_WRONLY), 1)
