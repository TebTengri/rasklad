#!/usr/bin/python3 -I
# SPDX-License-Identifier: MIT
# Rasklad: pause or resume automatic correction (the bar widget's middle click).
# Reads Rasklad's read-only status and writes only AutoCorrect (Fcitx merges a
# partial addon config) to the same Fcitx instance: both calls go to the unique
# bus name that owned org.fcitx.Fcitx5 when the status was read, so a Fcitx that
# restarted in between gets nothing. Does nothing unless the status is exactly
# on or paused (nothing while Rasklad is off). Exit status 0 only after a write
# that the status then shows,
# 3 when there is nothing to pause by design (Rasklad off, the profile not
# verified), 1 when Fcitx did not answer or answered something else; it prints
# nothing.
import re
import sys

from gi.repository import Gio, GLib

ADDON = re.compile(r"^[a-z][a-z0-9_]{0,31}$")


def main():
  # Optional addon name (the closed lab registers it as "raskladlab").
  addon = sys.argv[1] if len(sys.argv) == 2 else "rasklad"
  if len(sys.argv) > 2 or not ADDON.match(addon):
    return 2
  try:
    bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
    owner = bus.call_sync("org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus",
                          "GetNameOwner", GLib.Variant("(s)", ("org.fcitx.Fcitx5",)), GLib.VariantType("(s)"),
                          Gio.DBusCallFlags.NO_AUTO_START, 1000, None).unpack()[0]

    def call(method, args, reply_type):
      return bus.call_sync(owner, "/controller", "org.fcitx.Fcitx.Controller1", method, args,
                           GLib.VariantType(reply_type), Gio.DBusCallFlags.NO_AUTO_START, 1000,
                           None).unpack()

    def status():
      values = call("GetConfig", GLib.Variant("(s)", ("fcitx://config/addon/%s/status" % addon,)),
                    "(va(sa(sssva{sv})))")[0]
      return values if isinstance(values, dict) else None

    values = status()
    if values is None:
      return 1
    # Owner decision 2026-11-25: while Rasklad is off the middle click changes nothing.
    if values.get("Enabled") == "False" or values.get("ProfileReady") == "False":
      return 3
    # An addon from 0.5.30 on reports Enabled (and OnEpoch); only an older one,
    # always on, may leave it out. Anything incomplete is a failure, not a choice.
    if values.get("Enabled") != "True" and (values.get("Enabled") is not None or "OnEpoch" in values):
      return 1
    if values.get("ProfileReady") != "True":
      return 1
    auto = values.get("AutoCorrect")
    if auto not in ("True", "False"):
      return 1
    want = "False" if auto == "True" else "True"
    value = GLib.Variant("a{sv}", {"AutoCorrect": GLib.Variant("s", want)})
    call("SetConfig", GLib.Variant("(sv)", ("fcitx://config/addon/%s" % addon, value)), "()")
    # The addon puts the old value back if it cannot save: read it back.
    after = status()
    if after is None or after.get("AutoCorrect") != want:
      return 1
  except GLib.Error:
    return 1
  # SYS-272: the bar widget's helper reads the new status now, not on its next poll.
  try:
    bus.emit_signal(None, "/org/rasklad/Widget", "org.rasklad.Widget1", "Poke", None)
    bus.flush_sync(None)
  except GLib.Error:
    pass
  return 0


if __name__ == "__main__":
  sys.exit(main())
