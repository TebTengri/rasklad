#!/bin/sh
# SPDX-License-Identifier: MIT
# Rasklad: switch the focused window's Fcitx layout between keyboard-us and
# keyboard-ru. Run by the double-Alt Hyprland bind (double-alt.lua). Anything
# else current, or Fcitx not running, does nothing. Reads and sends only the
# input method names, never text.
call() {
  busctl --user --timeout=1 call org.fcitx.Fcitx5 /controller org.fcitx.Fcitx.Controller1 "$@"
}
case $(call CurrentInputMethod 2>/dev/null) in
  's "keyboard-us"') next=keyboard-ru ;;
  's "keyboard-ru"') next=keyboard-us ;;
  *) exit 0 ;;
esac
# Fcitx ignores a method that is not in the current group.
call SetCurrentIM s "$next" >/dev/null 2>&1 || exit 0
