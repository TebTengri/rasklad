# SYS-228/SYS-226/SYS-227: Arch package for the rasklad Fcitx5 addon (automatic
# correction by the reviewed local profile, double-Shift undo) and its
# settings window rasklad-settings.
# Built locally by tools/build_arch_package.sh from a git archive of this repo.
# Installs an Fcitx addon and a settings app: no service, autostart, setuid, udev
# or user configuration. Fcitx loads it on its next start.
pkgname=rasklad-fcitx5
pkgver=0.5.18
pkgrel=1
pkgdesc='Offline wrong-layout correction (us<->ru) for Fcitx5, in listed applications only'
arch=('x86_64')
url='https://github.com/TebTengri/rasklad'
license=('MIT' 'LicenseRef-hunspell-en-US' 'LicenseRef-hunspell-ru-RU')
depends=('fcitx5' 'qt6-base' 'qt6-declarative' 'hunspell' 'alsa-lib' 'python-gobject')
optdepends=('fcitx5-configtool: generic Fcitx settings'
            'hyprland: list open windows in rasklad-settings')
makedepends=('fcitx5' 'qt6-base' 'qt6-declarative' 'hunspell' 'alsa-lib')
source=("rasklad-${pkgver}.tar.gz" "rasklad-profile-${pkgver}.tar.gz")
sha256sums=('@SHA256@' '@PROFILE_SHA256@')

build() {
  cd "rasklad-${pkgver}"
  mkdir -p build/addon build/policy build/permissions build/cue build/settings build/settings-tests build/desktopindex-tests build/core build/gesture
  (cd build/addon && qmake6 ../../tools/fcitx_product.pro && make)
  (cd build/policy && qmake6 ../../tests/application_policy/application_policy.pro && make)
  (cd build/permissions && qmake6 ../../tests/application_permissions/application_permissions.pro && make)
  (cd build/cue && qmake6 ../../tests/layout_cue/layout_cue.pro && make)
  (cd build/settings && qmake6 ../../settings/settings.pro && make)
  (cd build/settings-tests && qmake6 ../../tests/settings/settings_tests.pro && make)
  (cd build/desktopindex-tests && qmake6 ../../tests/settings/desktopindex_tests.pro && make)
  (cd build/core && qmake6 ../../tests/product_core/product_core.pro && make)
  (cd build/gesture && qmake6 ../../tests/manual_gesture/manual_gesture.pro && make)
}

check() {
  cd "rasklad-${pkgver}"
  ./build/policy/application_policy_tests
  ./build/permissions/application_permissions_tests
  ./build/cue/layout_cue_tests
  ./build/settings-tests/settings_tests
  QT_QPA_PLATFORM=offscreen ./build/desktopindex-tests/desktopindex_tests
  ./build/core/product_core_tests
  ./build/gesture/manual_gesture_tests
  # The addon must not read the environment, load code, log, write files, or use D-Bus,
  # the network or processes (libc names, then Qt classes, which nm shows mangled).
  # Reading the pinned profile with QFile is expected; writing through Qt is not.
  local imports
  imports=$(nm -D --undefined-only build/addon/rasklad.so) || return 1
  [[ -n $imports ]] || return 1
  if grep -E -w 'getenv|secure_getenv|socket|connect|bind|send|sendto|sendmsg|getaddrinfo|fork|vfork|clone|exec[lv]p?e?|execveat|fexecve|posix_spawnp?|popen|system|syscall|ptrace|dlopen|dlsym|dbus_[a-z_]+|open|open64|openat|openat64|creat|fopen|fopen64|write|fwrite|syslog' <<<"$imports" ||
     grep -E 'QProcess|QDBus|QNetwork|QLocalSocket|QTcpSocket|QUdpSocket|QSaveFile|QTemporaryFile|QMessageLogger|QDebug|QLibrary|QPluginLoader|QSettings|_ZN9QIODevice5write|_ZN9QIODevice7putChar|_ZNK?4QDir|_ZN5QFile(6rename|6remove|4copy|4link|6resize)' <<<"$imports"; then
    echo 'unexpected import in rasklad.so' >&2
    return 1
  fi
}

package() {
  cd "rasklad-${pkgver}"
  install -Dm755 build/addon/rasklad.so "${pkgdir}/usr/lib/fcitx5/rasklad.so"
  install -Dm644 addon/rasklad.conf "${pkgdir}/usr/share/fcitx5/addon/rasklad.conf"
  install -Dm755 build/settings/rasklad-settings "${pkgdir}/usr/bin/rasklad-settings"
  install -Dm644 packaging/arch/rasklad-settings.desktop "${pkgdir}/usr/share/applications/rasklad-settings.desktop"
  # Double Alt: a Hyprland rule the user loads from bindings.lua, and the switch it runs.
  install -Dm755 packaging/arch/rasklad-layout-toggle "${pkgdir}/usr/bin/rasklad-layout-toggle"
  install -Dm755 packaging/arch/rasklad-layout-watch "${pkgdir}/usr/bin/rasklad-layout-watch"
  install -Dm755 packaging/arch/rasklad-pause-toggle "${pkgdir}/usr/bin/rasklad-pause-toggle"
  install -Dm755 packaging/arch/rasklad-setup "${pkgdir}/usr/bin/rasklad-setup"
  install -Dm644 packaging/hyprland/double-alt.lua "${pkgdir}/usr/share/${pkgname}/hyprland/double-alt.lua"
  # Omarchy bar widget (EN/RU from Fcitx); the user copies it into ~/.config/omarchy/plugins.
  install -Dm644 packaging/omarchy/rasklad.layout/manifest.json "${pkgdir}/usr/share/${pkgname}/omarchy/rasklad.layout/manifest.json"
  install -Dm644 packaging/omarchy/rasklad.layout/RaskladLayout.qml "${pkgdir}/usr/share/${pkgname}/omarchy/rasklad.layout/RaskladLayout.qml"
  install -Dm644 packaging/omarchy/rasklad.layout/i18n/en.json "${pkgdir}/usr/share/${pkgname}/omarchy/rasklad.layout/i18n/en.json"
  install -Dm644 packaging/omarchy/rasklad.layout/i18n/ru.json "${pkgdir}/usr/share/${pkgname}/omarchy/rasklad.layout/i18n/ru.json"
  install -Dm644 packaging/arch/rasklad-settings.svg "${pkgdir}/usr/share/icons/hicolor/scalable/apps/rasklad-settings.svg"
  # Reviewed detector profile (dictionaries, model, notices) at its pinned paths.
  (cd "${srcdir}/profile" && find . -type f -print0 | while IFS= read -r -d '' f; do
    [[ /$f/ != */../* ]] || return 1
    install -Dm644 "$f" "${pkgdir}/usr/share/fcitx5/rasklad/profile/${f#./}"
  done)
  # Licenses: MIT for Rasklad's own code, full dictionary notices and the record
  # of what Rasklad modified or derived (also marked next to the modified .aff).
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 data/notices/en_US.README.txt "${pkgdir}/usr/share/licenses/${pkgname}/en_US.README.txt"
  install -Dm644 data/notices/ru_RU.README.txt "${pkgdir}/usr/share/licenses/${pkgname}/ru_RU.README.txt"
  install -Dm644 packaging/arch/DATA-NOTICE.txt "${pkgdir}/usr/share/licenses/${pkgname}/DATA-NOTICE.txt"
  install -Dm644 data/notices/UKACD-readme.txt "${pkgdir}/usr/share/licenses/${pkgname}/UKACD-readme.txt"
  install -Dm644 packaging/arch/DATA-NOTICE.txt "${pkgdir}/usr/share/fcitx5/rasklad/profile/build/experiment-003-data/control/MODIFIED.txt"
  install -Dm644 docs/SYS-246-PRODUCT-ADDON.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
  install -Dm644 packaging/arch/INSTALL.md "${pkgdir}/usr/share/doc/${pkgname}/INSTALL.md"
  install -Dm644 SECURITY.md "${pkgdir}/usr/share/doc/${pkgname}/SECURITY.md"
}
